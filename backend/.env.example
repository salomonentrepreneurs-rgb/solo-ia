# Solo IA — Backend Configuration
# Copiez ce fichier en .env et remplissez vos clés

# === Server ===
PORT=3001
NODE_ENV=development

# === OpenAI ===
# Obtenez votre clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=votre-cle-openai-ici
OPENAI_MODEL=gpt-4o

# === Base de données ===
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/solo-ia.db

# === JWT (Authentification) ===
JWT_SECRET=changez-ce-secret-en-production-123456
JWT_EXPIRES_IN=7d

# === Vercel Deployment ===
# 1. Générez un token sur https://vercel.com/account/tokens
# 2. Créez un projet Vercel vide et récupérez son ID
VERCEL_TOKEN=votre-vercel-token-ici
VERCEL_TEAM_ID=  # optionnel, votre équipe Vercel
VERCEL_PROJECT_ID=  # ID du projet Vercel de destination

# === Solo IA Config ===
MAX_CREDITS_PER_DAY=10
MAX_APPS_PER_USER=50
APP_TIMEOUT_MS=120000